{
  "name": "windowservices-ca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/build.mjs && node --test tests/*.test.mjs && node scripts/audit.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:accessibility": "node tests/accessibility.mjs",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
